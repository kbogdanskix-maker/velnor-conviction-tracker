# Copy to .env.local and fill in. NEVER commit the real file.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Publishable key (sb_publishable_...). Replaces the legacy anon key, which was
# a JWT signed by the project's legacy JWT secret.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<sb_publishable_...>

# Backend origin used by the API rewrite in next.config.mjs
BACKEND_URL=http://localhost:8000
