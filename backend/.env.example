# Copy to .env and fill in. NEVER commit the real .env.

APP_ENV=development
DEBUG=true

# ── Database (Supabase Postgres) ──────────────────────────────────
# Use the Session Pooler URI from Supabase → Project Settings → Database
DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@<host>:5432/postgres
DATABASE_URL_SYNC=postgresql://postgres.<project-ref>:<password>@<host>:5432/postgres

# ── Supabase Auth ─────────────────────────────────────────────────
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-key>
SUPABASE_JWT_SECRET=<jwt-secret>

# ── Cache ─────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── AI (required for the AI surfaces and Deep Dive) ───────────────
ANTHROPIC_API_KEY=<your-anthropic-key>

# ── Optional data providers (features degrade gracefully if unset) ─
FRED_API_KEY=
FMP_API_KEY=
NEWSAPI_KEY=
OPEN_EXCHANGE_RATES_APP_ID=

# ── Optional billing (unused unless paid tiers are enabled) ───────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

FROM_EMAIL=hello@example.com
